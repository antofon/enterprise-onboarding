# copy to .env (git ignores every .env* file) and fill in what you need. everything has a working default except the LLM keys.

APP_ENV=dev
LOG_LEVEL=INFO
# json in containers, console when running locally
LOG_FORMAT=console

# docker compose publishes postgres on 127.0.0.1:5433 so it does not collide with a host postgres.
# inside compose the api uses db:5432 (set in docker-compose.yml).
DATABASE_URL=postgresql+psycopg://onboarding:onboarding@localhost:5433/onboarding

# where the migration layer sends records. the mock target platform is served by this same app.
# the token is fictional; the runner has to present it like it would to the real platform.
TARGET_API_BASE_URL=http://localhost:8000/target/v1
TARGET_API_TOKEN=meridian-staging-demo
# optional, with these defaults: one write per request, retried on a 5xx, a timeout or a
# malformed answer because writes carry their own identifier and a repeat is a no-op.
# TARGET_REQUEST_TIMEOUT_SECONDS=20
# TARGET_MAX_ATTEMPTS=3
# TARGET_RETRY_BACKOFF_SECONDS=0.25
# a 429 or 503 with Retry-After is waited out, up to this long per retry
# TARGET_RETRY_MAX_WAIT_SECONDS=10
# this many records in a row failing after their retries means the target is down: the run stops
# writing, counts the rest as not reached, and fails with the reason
# TARGET_BREAKER_THRESHOLD=10

# fault injection in the mock target, for rehearsing the migration's failure paths. off by
# default so a plain run only fails where the customer's data is bad. the draw is seeded with the
# record id, so the same records fail every time. modes: server_error, timeout, malformed.
# TARGET_FAULT_RATE=0.0
# TARGET_FAULT_MODES=server_error,timeout,malformed
# TARGET_FAULT_SEED=1337
# TARGET_FAULT_TIMEOUT_SECONDS=30
# rate_limited is a fourth mode (429 with Retry-After, nothing written). 0 attempts: a drawn
# record fails every attempt; n: only its first n attempts fail, the way a transient fault does.
# TARGET_FAULT_ATTEMPTS=0
# TARGET_FAULT_RETRY_AFTER_SECONDS=1

# the customer's value maps and rule settings for the transformation stage: reviewed
# configuration, one file per customer, never written by a model.
# TRANSFORMATION_CONFIG=sample_customer/transformation_config.yaml
# how many validation issues and target refusals one run stores in full before it keeps
# counting without storing.
# VALIDATION_ISSUE_LIMIT=5000
# MIGRATION_FAILURE_LIMIT=2000
# a run still `running` with no heartbeat for this long belongs to a process that stopped; it is
# marked failed when the api starts and before the project's next run.
# RUN_STALE_AFTER_SECONDS=600

# readiness policy: an entity where fewer than this share of its in-scope records landed in the
# rehearsal blocks go-live; anything short of all of them is a condition the customer signs off.
# READINESS_MIN_ENTITY_COVERAGE=0.95

# the customer's legacy billing system is simulated by this same app under /mock/billing/v1.
# the token is fictional; it exists so the loader has to authenticate like it would for real.
BILLING_API_BASE_URL=http://localhost:8000/mock/billing/v1
BILLING_API_TOKEN=legacybill-readonly-demo
BILLING_SOURCE_FILE=sample_customer/data/subscriptions.json
# the loader retries a 429 or a 5xx, waiting what Retry-After says (capped) or a linear backoff.
# BILLING_MAX_ATTEMPTS=4
# BILLING_RETRY_BACKOFF_SECONDS=0.5
# BILLING_RETRY_MAX_WAIT_SECONDS=10
# the mock feed's rate limit: this many requests per window, then 429 with Retry-After. 0 is off.
# BILLING_RATE_LIMIT=0
# BILLING_RATE_WINDOW_SECONDS=1

# anthropic | openai | none. "none" is manual mode: profiling, comparison, review, transforms,
# validation, dry runs and reconciliation all still work; mapping proposals then come from the
# deterministic comparison instead of a model, with no confidence invented.
LLM_PROVIDER=none
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
# optional, with these defaults: one model call runs one to two minutes, datasets are asked
# about in parallel, and a proposal that breaks the contract is sent back up to three times.
# LLM_TIMEOUT_SECONDS=300
# LLM_PARALLEL_CALLS=4
# LLM_MAX_ATTEMPTS=3

# review thresholds. at or above high: bulk-approvable and green. below low: red. a person
# still decides every field; these only steer attention.
# MAPPING_HIGH_CONFIDENCE=0.85
# MAPPING_LOW_CONFIDENCE=0.6

# where context documents (the customer's business rules, kickoff notes) may be read from.
# DOCUMENT_ROOTS=sample_customer,generated
